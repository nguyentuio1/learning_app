# LA-328: copy to .env (ignored by git) and replace every value before `docker compose up`.
# Never commit .env. Use different values for every shared or production environment.

# PostgreSQL (docker-compose.yml, service postgres)
POSTGRES_PASSWORD=change-me-postgres-password

# MinIO (docker-compose.yml, service minio). The password must be at least 8 characters.
MINIO_ROOT_USER=drone-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
