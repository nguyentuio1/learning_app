# LA-328 / LA-47: copy to .env (ignored by git) and fill in every empty value before `docker compose up`;
# compose refuses to start while a required one is empty.
# Never commit .env. Use different values for every shared or production environment.
# Avoid ; and spaces in POSTGRES_PASSWORD (it is placed inside a connection string).

# PostgreSQL (docker-compose.yml, service postgres)
POSTGRES_PASSWORD=

# MinIO (docker-compose.yml, service minio). The password must be at least 8 characters.
MINIO_ROOT_USER=drone-minio
MINIO_ROOT_PASSWORD=

# API (docker-compose.yml, service api). At least 32 random bytes, for example: openssl rand -base64 48
JWT_KEY=

# First administrator, created on the first start of the api service when ADMIN_PASSWORD is set
# (8 to 100 characters with a letter and a digit). Change it after the first sign-in.
ADMIN_EMAIL=admin@smartdronedelivery.com
ADMIN_PASSWORD=

# Optional. Address of MinIO as browsers and phones see it (avatar and package photo URLs).
# MINIO_PUBLIC_URL=http://localhost:9000
# For web + emulator/physical-device use together, set a workstation LAN address
# reachable by every client, e.g. http://192.168.1.10:9000 (use your actual IP).
# Changing only Flutter API_BASE_URL does not rewrite absolute photo URLs.
# Optional. Host ports: API 5055, web portal 8080, PostgreSQL 5433, MinIO 9000/9001.
# API_HOST_PORT=5055
# WEB_HOST_PORT=8080
# Optional. Production by default; Development turns on Swagger and the demo accounts (README).
# ASPNETCORE_ENVIRONMENT=Production

# Optional Gemini overlay: docker-compose.gemini.yml. Server-side key only.
# GEMINI_API_KEY=
# AI_MODEL_NAME=gemini-3.5-flash-lite
# AI_MODEL_REVISION=gemini-3.5-flash-lite
# AI_GEMINI_TRANSIENT_RETRY_ENABLED=false
# AI_ETA_ENABLED=false
# AI_SUMMARY_ENABLED=false
# AI_ASSISTANT_ENABLED=false
# AI_ASSISTANT_UI_ENABLED=false
# Assistant activation additionally needs the documented retention/cloud-policy approvals.
# See docs/deployment/gemini-ai.md. Do not set approval markers by copying a sample.
# Optional. Demo simulator overrides forwarded into the api container (LA-186 / LA-188).
# DroneSimulator__Enabled=false
# DeliveryFlight__CruiseSpeedMps=12
