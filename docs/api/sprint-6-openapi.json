  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "OrderStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "READY_FOR_TAKEOFF",
          "IN_TRANSIT",
          "ARRIVED",
          "DELIVERED",
          "CANCELLED",
          "FAILED"
        ]
      },
      "Problem": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "attemptsRemaining": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          },
          "lockoutExpiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TelemetryPosition": {
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "altitudeMeters",
          "speedMps",
          "batteryPercentage",
          "timestamp"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "altitudeMeters": {
            "type": "number"
          },
          "speedMps": {
            "type": "number"
          },
