{
  "openapi": "3.0.3",
  "info": {
    "title": "Staff delivery insight lookup",
    "version": "1.0.0",
    "description": "LA-355 additive selection API. Existing ETA/summary authorization and activation remain unchanged."
  },
  "paths": {
    "/api/delivery-insights/orders": {
      "get": {
        "operationId": "lookupStaffDeliveryInsights",
        "summary": "Find current and historical deliveries by tracking number",
        "description": "Active persisted DISPATCHER or MANAGER only. Reject unknown/repeated query parameters with400. No contact, customer, package, address or pickup-code fields. Newest creation time first, ID ascending for ties. Counts/items may change during concurrent operational updates.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "searchKeyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 50
            },
            "description": "Trimmed case-insensitive literal tracking-number substring; blank means no filter."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional case-insensitive status: PENDING, APPROVED, READY_FOR_TAKEOFF, IN_TRANSIT, ARRIVED, DELIVERED, CANCELLED, FAILED. Blank means all."
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Optional inclusive creation calendar day in Asia/Ho_Chi_Minh. YYYY-MM-DD only; UTC boundary must be representable."
          },
          {
            "name": "toDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Optional inclusive creation calendar day in Asia/Ho_Chi_Minh, not before fromDate. Exclusive next-day UTC boundary must be representable."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 1
            },
            "description": "One-based page; beyond the result returns empty items and the actual filtered count."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Maximum100 returned records."
          }
        ],
        "responses": {
          "200": {
            "description": "Paged lookup; empty results remain200.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryInsightPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/unknown/repeated query; standard envelope with errors keyed by parameter."
          },
          "401": {
            "description": "Missing, invalid, expired identity or missing user."
          },
          "403": {
            "description": "Inactive user or unauthorized current role."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DeliveryInsightOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "trackingNumber",
          "status",
          "originStationName",
          "destinationStationName",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trackingNumber": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "READY_FOR_TAKEOFF",
              "IN_TRANSIT",
              "ARRIVED",
              "DELIVERED",
              "CANCELLED",
              "FAILED"
            ]
          },
          "originStationName": {
            "type": "string"
          },
          "destinationStationName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp."
          }
        }
      },
      "DeliveryInsightPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/DeliveryInsightOrder"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
